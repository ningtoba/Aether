{
  "name": "@aether/plugin-system",
  "version": "0.1.0",
  "description": "Aether plugin system — manifest, loader, sandbox, UI extensions, tool registration",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest/schema.d.ts",
      "import": "./dist/manifest/schema.js"
    },
    "./registry": {
      "types": "./dist/registry/registry.d.ts",
      "import": "./dist/registry/registry.js"
    },
    "./sandbox": {
      "types": "./dist/sandbox/sandbox.d.ts",
      "import": "./dist/sandbox/sandbox.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "@types/node": "^22.0.0"
  }
}
