{
  "name": "@aether/core",
  "version": "0.2.0",
  "private": true,
  "description": "Aether security foundation: RBAC (hierarchical roles, permissions, access decisions)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
