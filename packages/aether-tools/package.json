{
  "name": "@aether/tools",
  "version": "0.1.0",
  "description": "Aether tool runtime, sandboxes, and execution: registry, shell, Docker, Playwright, Python venv, TS runtime",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aether/core": "*",
    "dockerode": "^4.0.5",
    "playwright-core": "^1.52.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/dockerode": "*",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
