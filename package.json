{
  "name": "aether",
  "version": "0.2.0",
  "private": true,
  "description": "Aether — Autonomous AI orchestration platform (web)",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.3.14"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b --force",
    "typecheck": "tsc -b --force",
    "clean": "npm run clean --workspaces",
    "lint": "eslint packages/*/src/",
    "format": "prettier --write 'packages/*/src/**/*.ts'",
    "format:check": "prettier --check 'packages/*/src/**/*.ts'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:coverage": "vitest run --coverage",
    "build:frontend": "npm run build -w @aether/frontend",
    "dev:backend": "bun run --watch packages/aether-backend/src/main.ts",
    "dev": "npm run dev:backend",
    "start": "bun run packages/aether-backend/src/main.ts",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "3.2.4",
    "concurrently": "^9.2.1",
    "eslint": "^9.0.0",
    "madge": "8.0.0",
    "prettier": "^3.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.68.0",
    "vitest": "^3.0.0"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-win32-x64-msvc": "4.3.0",
    "lightningcss-win32-x64-msvc": "1.32.0"
  }
}
