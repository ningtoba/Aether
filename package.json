{
  "name": "aether",
  "version": "0.1.0",
  "private": true,
  "description": "Aether — Autonomous AI orchestration platform",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b --force",
    "typecheck": "tsc -b --force",
    "clean": "npm run clean --workspaces",
    "lint": "eslint packages/*/src/",
    "format": "prettier --write 'packages/*/src/**/*.ts'",
    "format:check": "prettier --check 'packages/*/src/**/*.ts'",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:frontend": "npm run dev -w @aether/frontend",
    "dev:backend": "npm run dev -w @aether/backend",
    "dev:electron": "npm run dev -w @aether/electron",
    "dev": "npm run dev:backend",
    "start": "npm run dev:electron"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.0.0",
    "prettier": "^3.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  },
  "optionalDependencies": {
    "lightningcss-win32-x64-msvc": "1.32.0",
    "@tailwindcss/oxide-win32-x64-msvc": "4.3.0"
  },
  "dependencies": {
    "@langchain/langgraph": "^1.3.0"
  }
}
