{
  "name": "aether",
  "version": "0.1.0",
  "private": true,
  "description": "Fully autonomous AI orchestration and execution platform",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "concurrently -n types,electron -c blue,green \"npm run dev -w aether-types\" \"npm run dev -w aether-electron\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint packages/ --ext .ts,.tsx",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present && rimraf dist node_modules",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.16.0",
    "prettier": "^3.4.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0"
  }
}
